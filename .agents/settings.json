{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill(update-config)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(open *)",
      "Bash(grep *)",
      "Bash(touch *)",
      "Bash(md-to-pdf *)",
      "Bash(cp *)",
      "Bash(gh api *)",
      "Bash(brew list *)",
      "Bash(pdflatex *)",
      "Bash(lualatex *)",
      "Bash(kpsewhich *)",
      "Bash(tlmgr list *)",
      "Bash(curl *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(ln *)",
      "Bash(python:*)",
      "Bash(pip install:*)"
